/dts-v1/;

#include "rk3506-luckfox-lyra-ultra.dtsi"

/ {
	model = "Luckfox Lyra Pi";
	compatible = "rockchip,rk3506g-demo-display-control", "rockchip,rk3506";

	es8311_sound: es8311-sound {
		status = "okay";
		compatible = "simple-audio-card";
		simple-audio-card,format = "i2s";
		simple-audio-card,mclk-fs = <256>;
		simple-audio-card,name = "rockchip,es8311-sound";
		simple-audio-card,cpu {
			sound-dai = <&sai1>;
		};
		simple-audio-card,codec {
			sound-dai = <&es8311>;
		};

	};

	vcc3v3_lcd: vcc3v3-lcd {
		status = "okay";
		compatible = "regulator-fixed";
		pinctrl-names = "default";
		pinctrl-0 = <&lcd_pwren_h>;
		regulator-name = "vcc3v3_lcd";
		regulator-always-on;
	};
};

/**********media**********/
&mmc{
	/* For eMMC */
	max-frequency = <52000000>;
	mmc-ddr-1_8v;
	bus-width = <4>;
	supports-emmc;
	cap-mmc-highspeed;
	disable-wp;
	//no-sd;
	//no-sdio;
	non-removable;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc_clk_pins &sdmmc_cmd_pins &sdmmc_bus4_pins>;
	status = "okay";
};

&fspi {
	status = "okay";

	flash@0 {
		compatible = "spi-nand";
		reg = <0>;
		spi-max-frequency = <80000000>;
		spi-rx-bus-width = <4>;
		spi-tx-bus-width = <1>;
	};
};

/**********ethernet**********/
&gmac0 {
	/*
	 * Supply CLK_MAC_OUT as "clk_mac_refout".
	 *
	 * ROOT CAUSE of both Ethernet ports coming up dead from cold boot:
	 * dwmac-rk's rk_gmac_clk_init() asks for "clk_mac_refout" whenever the
	 * interface is RMII and clock_in_out is "output" (our case), and
	 * gmac_clk_enable() prepare_enables it from rk_gmac_powerup(), which runs
	 * BEFORE stmmac_dvr_probe() -> stmmac_mdio_register() performs the PHY
	 * reset. The vendor dtsi never supplies that clock, so the get returned
	 * -ENOENT ("cannot get clock clk_mac_refout") and the 25 MHz PHY reference
	 * was never enabled in the probe path. Both CH182H2 PHYs were therefore
	 * brought out of reset unclocked and stayed dead -- MDIO still answered,
	 * because the PHY register block is clocked by MDC from the MAC, but there
	 * was no autoneg, no carrier and no link LEDs on either port.
	 *
	 * Confirmed on hardware: unbind+rebind of rk_gmac-dwmac (which re-resets
	 * the PHY with the clock already running) brings both ports straight up at
	 * 100Mbps/Full with DHCP leases.
	 *
	 * CLK_MAC_OUT is a single clock shared by both MACs; the clock framework
	 * refcounts the two enables.
	 */
	clocks = <&cru CLK_MAC0>, <&cru CLK_MAC0_PTP>,
		 <&cru PCLK_MAC0>, <&cru ACLK_MAC0>,
		 <&cru CLK_MAC_OUT>;
	clock-names = "stmmaceth", "ptp_ref",
		      "pclk_mac", "aclk_mac",
		      "clk_mac_refout";

	phy-mode = "rmii";
	clock_in_out = "output";

	assigned-clocks = <&cru CLK_MAC_OUT>;
	assigned-clock-rates = <25000000>;

	snps,reset-gpio = <&gpio1 RK_PC0 GPIO_ACTIVE_LOW>;
	snps,reset-active-low;
	/*
	 * Reset timing widened from the vendor's <0 20000 100000>.
	 *
	 * stmmac reads these as <delay-before-assert, assert-duration,
	 * delay-after-deassert>. The vendor value asserts PHY reset with ZERO
	 * delay after gmac_clk_enable() turns on the 25 MHz reference, and then
	 * allows only 100 ms before phylib starts reading/configuring the PHY.
	 * On this board that is too tight: the CH182H2 comes out of reset before
	 * its reference is stable, and the link never negotiates even though MDIO
	 * answers. Evidence: a later phy_init_hw() -- which is what `ip link set
	 * down/up` and a driver rebind both trigger -- brings the link straight up
	 * at 100Mbps/Full, whereas `ethtool -r` (autoneg restart without a PHY
	 * soft reset) never recovers it.
	 *
	 * 20 ms lets the reference clock settle before reset is asserted, and
	 * 300 ms lets the PHY's internal PLL lock before the first MDIO access.
	 * Costs ~0.34 s of boot time per port.
	 */
	snps,reset-delays-us = <20000 20000 300000>;

	pinctrl-names = "default";
	pinctrl-0 = <&eth_clk0_25m_out_pins
			 &eth_rmii0_miim_pins
			 &eth_rmii0_tx_bus2_pins
			 &eth_rmii0_rx_bus2_pins
			 &eth_rmii0_clk_pins
			 &rmii0_rstn>;

	phy-handle = <&rmii_phy0>;
	status = "okay";
};

&gmac1 {
	/*
	 * Supply CLK_MAC_OUT as "clk_mac_refout".
	 *
	 * ROOT CAUSE of both Ethernet ports coming up dead from cold boot:
	 * dwmac-rk's rk_gmac_clk_init() asks for "clk_mac_refout" whenever the
	 * interface is RMII and clock_in_out is "output" (our case), and
	 * gmac_clk_enable() prepare_enables it from rk_gmac_powerup(), which runs
	 * BEFORE stmmac_dvr_probe() -> stmmac_mdio_register() performs the PHY
	 * reset. The vendor dtsi never supplies that clock, so the get returned
	 * -ENOENT ("cannot get clock clk_mac_refout") and the 25 MHz PHY reference
	 * was never enabled in the probe path. Both CH182H2 PHYs were therefore
	 * brought out of reset unclocked and stayed dead -- MDIO still answered,
	 * because the PHY register block is clocked by MDC from the MAC, but there
	 * was no autoneg, no carrier and no link LEDs on either port.
	 *
	 * Confirmed on hardware: unbind+rebind of rk_gmac-dwmac (which re-resets
	 * the PHY with the clock already running) brings both ports straight up at
	 * 100Mbps/Full with DHCP leases.
	 *
	 * CLK_MAC_OUT is a single clock shared by both MACs; the clock framework
	 * refcounts the two enables.
	 */
	clocks = <&cru CLK_MAC1>, <&cru CLK_MAC1_PTP>,
		 <&cru PCLK_MAC1>, <&cru ACLK_MAC1>,
		 <&cru CLK_MAC_OUT>;
	clock-names = "stmmaceth", "ptp_ref",
		      "pclk_mac", "aclk_mac",
		      "clk_mac_refout";

	phy-mode = "rmii";
	clock_in_out = "output";

	snps,reset-gpio = <&gpio1 RK_PC1 GPIO_ACTIVE_HIGH>;
	snps,reset-active-high;
	/*
	 * Reset timing widened from the vendor's <0 20000 100000>.
	 *
	 * stmmac reads these as <delay-before-assert, assert-duration,
	 * delay-after-deassert>. The vendor value asserts PHY reset with ZERO
	 * delay after gmac_clk_enable() turns on the 25 MHz reference, and then
	 * allows only 100 ms before phylib starts reading/configuring the PHY.
	 * On this board that is too tight: the CH182H2 comes out of reset before
	 * its reference is stable, and the link never negotiates even though MDIO
	 * answers. Evidence: a later phy_init_hw() -- which is what `ip link set
	 * down/up` and a driver rebind both trigger -- brings the link straight up
	 * at 100Mbps/Full, whereas `ethtool -r` (autoneg restart without a PHY
	 * soft reset) never recovers it.
	 *
	 * 20 ms lets the reference clock settle before reset is asserted, and
	 * 300 ms lets the PHY's internal PLL lock before the first MDIO access.
	 * Costs ~0.34 s of boot time per port.
	 */
	snps,reset-delays-us = <20000 20000 300000>;

	pinctrl-names = "default";
	pinctrl-0 = <&eth_clk1_25m_out_pins
			 &eth_rmii1_miim_pins
			 &eth_rmii1_tx_bus2_pins
			 &eth_rmii1_rx_bus2_pins
			 &eth_rmii1_clk_pins
			 &rmii1_rstn>;

	phy-handle = <&rmii_phy1>;
	status = "okay";
};

&mdio0 {
	rmii_phy0: phy@1 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0x1>;
		clocks = <&cru CLK_MAC_OUT>;
		assigned-clocks = <&cru CLK_MAC_OUT>;
		assigned-clock-rates = <25000000>;
	};
};

&mdio1 {
	rmii_phy1: phy@1 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0x1>;
		clocks = <&cru CLK_MAC_OUT>;
		assigned-clocks = <&cru CLK_MAC_OUT>;
		assigned-clock-rates = <25000000>;
	};
};

/**********usb**********/
&usb20_otg0 {
	dr_mode = "peripheral";
	status = "okay";
};

&usb20_otg1 {
	/*
	 * Luckfox Lyra Pi wires otg1 to the on-board CH334F USB hub, which feeds
	 * the two USB-A ports (J2) and the USB2 pin header (H1). A downstream hub
	 * only enumerates with the controller in host mode; the vendor DTS ships
	 * "otg" here, and with no ID pin or extcon wired on this port dwc2 comes
	 * up as a peripheral and the USB-A ports stay dead. The sibling Lyra Ultra
	 * dtsi uses "host" for the same hub topology.
	 *
	 * USB-C (otg0) is untouched and remains a peripheral/gadget port.
	 */
	dr_mode = "host";
	status = "okay";
};

/**********audio**********/
&sai4 {
	status = "okay";
};

&audio_codec {
	status = "okay";
};

&i2c2 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&rm_io1_i2c2_scl &rm_io0_i2c2_sda>;

	es8311: es8311@18 {
		compatible = "everest,es8311";
		reg = <0x18>;
		clocks = <&mclkout_sai1>;
		clock-names = "mclk";
		assigned-clocks = <&mclkout_sai1>;
		assigned-clock-rates = <12288000>;

		#sound-dai-cells = <0>;
		adc-pga-gain = <6>; /* 18dB */
		adc-volume = <0xbf>; /* 0dB */
		dac-volume = <0xbf>; /* 0dB */
		aec-mode = "adc left, adc right";
	};
};

&sai1 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&rm_io16_sai1_mclk
			 &rm_io17_sai1_sclk
			 &rm_io18_sai1_lrck
			 &rm_io28_sai1_sdi
			 &rm_io29_sai1_sdo0>;
};

/**********pinctrl**********/
&pinctrl {
	ethernet {
		rmii0_rstn: rmii0-rstn {
			rockchip,pins = <1 RK_PC0 RK_FUNC_GPIO &pcfg_pull_up>;
		};

		rmii1_rstn: rmii1-rstn {
			rockchip,pins = <1 RK_PC1 RK_FUNC_GPIO &pcfg_pull_down>;
		};
	};

	lcd {
		lcd_pwren_h: lcd-pwren-h {
			rockchip,pins = <1 RK_PC4 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	rm_io0 {
		rm_io0_i2c2_sda: rm-io0-i2c2-sda {
			rockchip,pins = <0 RK_PA0 35 &pcfg_pull_up>;
		};
	};

	rm_io1 {
		rm_io1_i2c2_scl: rm-io1-i2c2-scl {
			rockchip,pins = <0 RK_PA1 34 &pcfg_pull_up>;
		};
	};

	acodec-dsm {
		/omit-if-no-ref/
		dsm_spk_ctrl: dsm-spk-ctrl {
			rockchip,pins = <1 RK_PC6 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	dsm_aud {
		/omit-if-no-ref/
		dsm_audm1_pins: dsm-audm1-pins {
			rockchip,pins =
				/* dsm_aud_rn_m1 */
				<2 RK_PB4 2 &pcfg_pull_none>,
				/* dsm_aud_rp_m1 */
				<2 RK_PB5 2 &pcfg_pull_none>;
		};

		/omit-if-no-ref/
		dsm_audm1_iodown_pins: dsm-audm1-iodown-pins {
			rockchip,pins =
				/* dsm_aud_rn_m1 */
				<2 RK_PB4 RK_FUNC_GPIO &pcfg_pull_down>,
				/* dsm_aud_rp_m1 */
				<2 RK_PB5 RK_FUNC_GPIO &pcfg_pull_down>;
		};
	};
};
