# Board side of the USB-C network link. Fixed address, and a DHCP server so the
# host end configures itself: the board is always at 192.168.7.1.
[Match]
Name=usb0

[Network]
Address=192.168.7.1/24
DHCPServer=yes
LinkLocalAddressing=no
MulticastDNS=yes

[DHCPServer]
PoolOffset=10
PoolSize=10
EmitDNS=no
EmitRouter=no
